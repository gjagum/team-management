// Cloudflare Workers config: one Worker serves both the API and the built frontend.
// Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
//
// One-time setup before the first deploy:
//   wrangler r2 bucket create team-management-documents
//   wrangler secret put DATABASE_URL     # Postgres (Neon) connection string
//   wrangler secret put JWT_SECRET
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "team-management",
  "main": "backend/src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // Build the Vite frontend and generate the Prisma client (WASM engine for Workers)
  "build": {
    "command": "bun run --filter @team-management/frontend build && bun run --filter @team-management/backend prisma:generate"
  },

  // Frontend served from Cloudflare's CDN; the Worker only runs for API routes
  "assets": {
    "directory": "frontend/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },

  // Employee document uploads
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "team-management-documents"
    }
  ],

  // Optional, recommended for latency: pool Postgres connections with Hyperdrive.
  //   wrangler hyperdrive create team-db --connection-string="<non-pooler Neon URL>"
  // then uncomment and paste the id. worker.ts prefers it over DATABASE_URL.
  // "hyperdrive": [
  //   { "binding": "HYPERDRIVE", "id": "<HYPERDRIVE_ID>" }
  // ],

  "vars": {
    "BUN_VERSION": "1.4.2",
    "NODE_ENV": "production"
  },

  "observability": {
    "enabled": true
  }
}

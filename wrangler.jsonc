// Cloudflare Workers config: one Worker serves both the API and the built frontend.
// Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
//
// NOTE: not deployable yet. Remaining work before `wrangler deploy`:
//   1. backend/src/worker.ts  – Worker entry that exports the Hono app (split app from Bun.serve in index.ts)
//   2. Prisma driver adapter  – @prisma/adapter-pg over the HYPERDRIVE binding (no TCP engine on Workers)
//   3. Uploads → R2           – documents.ts uses the local filesystem; switch to the DOCUMENTS binding
//   4. jsonwebtoken → hono/jwt (Web Crypto)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "team-management",
  "main": "backend/src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // Build the Vite frontend before each deploy / dev session
  "build": {
    "command": "bun run --filter @team-management/frontend build"
  },

  // Frontend served from Cloudflare's CDN; Worker only runs for API routes
  "assets": {
    "directory": "frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },

  // Postgres via Hyperdrive. Create with:
  //   wrangler hyperdrive create team-db --connection-string="postgres://user:pass@host:5432/teammanagement"
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "<HYPERDRIVE_ID>",
      // Used by `wrangler dev` instead of the remote Hyperdrive config
      "localConnectionString": "postgres://teamuser:teampass@localhost:5432/teammanagement"
    }
  ],

  // Employee document uploads. Create with: wrangler r2 bucket create team-management-documents
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "team-management-documents"
    }
  ],

  // Non-secret config. Set secrets with: wrangler secret put JWT_SECRET
  "vars": {
    "NODE_ENV": "production"
  },

  "observability": {
    "enabled": true
  }
}

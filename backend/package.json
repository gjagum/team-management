{
  "name": "@team-management/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "cd ../frontend && bun run build && cd ../backend && bun run copy-static && bun run prisma:generate",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "seed": "bun prisma/seed.ts",
    "test": "bun test src/",
    "typecheck": "tsc --noEmit",
    "copy-static": "bun -e \"const fs = require('node:fs'); fs.rmSync('static', { recursive: true, force: true }); fs.cpSync('../frontend/dist', 'static', { recursive: true })\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "5.22.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "hono": "^4.12.8",
    "jsonwebtoken": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "^1.2.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/pg": "^8.23.1",
    "prisma": "^5.22.0",
    "typescript": "^5.6.3"
  }
}

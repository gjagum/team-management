{
  "tasks": {
    "dev": "deno run --allow-net --allow-read --allow-write --allow-env --allow-ffi --watch src/index.ts",
    "start": "deno run --allow-net --allow-read --allow-write --allow-env --allow-ffi src/index.ts",
    "build": "cd ../frontend && deno task build && rm -rf ../backend/static && cp -r dist ../backend/static && cd ../backend && deno run -A npm:prisma generate",
    "prisma:generate": "deno run -A npm:prisma generate",
    "prisma:push": "deno run -A npm:prisma db push",
    "seed": "deno run --allow-net --allow-read --allow-env --allow-ffi ./prisma/seed.ts",
    "test": "deno test --allow-net --allow-read --allow-env --allow-ffi src/"
  },
  "imports": {
    "@prisma/client": "npm:@prisma/client@^5.20.0",
    "hono": "npm:hono@^4.0.0",
    "hono/": "npm:/hono/",
    "@hono/node-server": "npm:@hono/node-server@^1.8.0",
    "jsonwebtoken": "npm:jsonwebtoken@^9.0.2",
    "bcryptjs": "npm:bcryptjs@^2.4.3",
    "zod": "npm:zod@^3.22.4",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "pdf-lib": "npm:pdf-lib@^1.17.1"
  },
  "compilerOptions": {
    "lib": ["deno.window"]
  },
  "nodeModulesDir": "auto",
  "allowScripts": [
    "npm:@prisma/client@5.22.0",
    "npm:@prisma/engines@5.22.0",
    "npm:esbuild@0.27.4",
    "npm:prisma@5.22.0"
  ],
  "deploy": {
    "org": "gjagum",
    "app": "team-management"
  }
}

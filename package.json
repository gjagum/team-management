{
  "name": "team-management",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:restart": "bun scripts/dev-restart.ts",
    "dev:stack": "bun scripts/dev-stack.ts",
    "dev:backend": "bun run --filter @team-management/backend dev",
    "dev:frontend": "bun run --filter @team-management/frontend dev",
    "build": "bun run --filter @team-management/backend build",
    "start": "bun run --filter @team-management/backend start",
    "test": "bun run --filter @team-management/backend test",
    "db:studio": "cd backend && node node_modules/prisma/build/index.js studio --port 5555"
  },
  "trustedDependencies": [
    "@prisma/client",
    "@prisma/engines",
    "prisma",
    "esbuild"
  ],
  "devDependencies": {
    "wrangler": "^4.160.1"
  }
}

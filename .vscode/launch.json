{
  "version": "0.2.0",
  "configurations": [
    {
      "request": "launch",
      "name": "Backend: Debug",
      "type": "node",
      "program": "${workspaceFolder}/backend/src/index.ts",
      "cwd": "${workspaceFolder}/backend",
      "runtimeExecutable": "/home/gjagum/.deno/bin/deno",
      "runtimeArgs": [
        "run",
        "--config",
        "./deno.json",
        "--inspect-wait",
        "--allow-all"
      ],
      "attachSimplePort": 9229
    },
    {
      "request": "launch",
      "name": "Frontend: Vite Dev Server",
      "type": "node",
      "program": "${workspaceFolder}/frontend/node_modules/vite/bin/vite.js",
      "cwd": "${workspaceFolder}/frontend",
      "runtimeExecutable": "/home/gjagum/.deno/bin/deno",
      "runtimeArgs": [
        "run",
        "-A",
        "--inspect-wait=9230",
        "--config",
        "./deno.json"
      ],
      "args": ["--host"],
      "attachSimplePort": 9230
    },
    {
      "request": "launch",
      "name": "Frontend: Chrome",
      "type": "chrome",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/frontend/src",
      "sourceMapPathOverrides": {
        "/__vite/*": "${webRoot}/*"
      }
    }
  ],
  "compounds": [
    {
      "name": "Full Stack",
      "configurations": ["Backend: Debug", "Frontend: Vite Dev Server"]
    }
  ]
}
